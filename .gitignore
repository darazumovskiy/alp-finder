# Данные (десятки ГБ, тянутся скриптами по манифесту)
data/
download.log
logs/

# Выгрузка Telegram-переписки — не публикуется, каждый выгружает сам (см. README)
docs/telegram/

# Секреты Telegram: ключи API и файл сессии = доступ к учётке
scripts/.tg_env
scripts/.tg_session*

# Python-окружения
.venv/
__pycache__/

# Производные артефакты детектора (регенерируются analysis/detect.py, video_scan.py)
analysis/pilot/gt-results/crops/
analysis/pilot/scan-*/
# Сканы всего архива: кропы и монтажи — десятки тысяч jpg; tracks.tsv оставляем в git
analysis/scans/*/crops/
analysis/scans/*/montage_*.jpg
analysis/scans-low/*/crops/
analysis/scans-low/*/montage_*.jpg
# Полнокадровые выгрузки (регенерируются из data/drive)
analysis/fullframe/

# Прогоны стенда врезок (регенерируются analysis/inject_probe.py; цифры - в docs/video-analysis.md)
analysis/floor-*/

# Мозаики склейки пролётов (регенерируются analysis/stitch.py)
analysis/stitch/

# Сборка публичного просмотрщика (регенерируется analysis/viewer/build_dist.py)
analysis/viewer/dist/
# Постоянный клон gh-pages для инкрементального деплоя зеркала (scripts/deploy_mirror.sh)
analysis/viewer/.mirror/
# Кеш плеера полётов: кадры и мета (регенерируется analysis/flight_cache.py)
analysis/viewer/flights/
# Кэш wrangler (деплой Cloudflare Pages)
.wrangler/

*.log

# Клоны внешних репозиториев коллег (вложенные git-репы, обновляются git pull)
external/

# Рабочий мусор сессий и разовые передачи
tmp/
srt-drone-part3.zip

# Локальные памятки — не публикуются
*.local.md

# Воркер Basic Auth тим-версии: содержит пароль (см. docs/zakrytaya-zona.local.md)
analysis/viewer/_worker.js

.DS_Store

# Слой следов и отбор кадров участка: тяжёлые артефакты прогонов не коммитятся
analysis/scans-furrow/*/crops/
analysis/scans-furrow/*/montage_*.jpg
analysis/trace-frames/*/*.jpg
analysis/debug-furrow/
analysis/tg_activity.sqlite

# NASA Earthdata token
nasa.token.txt

# Ортомозаика (analysis/build_ortho.py): рабочие тайлы и публикуемые блоки
